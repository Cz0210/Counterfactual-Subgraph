{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "status",
    "created_at",
    "updated_at",
    "spec_path",
    "local_commit",
    "remote_commit",
    "slurm_jobs",
    "adopted_stages",
    "next_stage",
    "remote_write_performed",
    "stages",
    "approvals",
    "stop_reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "DRY_RUN_COMPLETED",
        "ADOPT_EXISTING_DRY_RUN",
        "LOCAL_PREFLIGHT",
        "LOCAL_GATE_RUNNING",
        "LOCAL_GATE_PASSED",
        "LOCAL_GATE_FAILED",
        "COMMITTING",
        "PUSHED",
        "REMOTE_SYNCING",
        "REMOTE_PREFLIGHT",
        "REMOTE_PREFLIGHT_RUNNING",
        "REMOTE_PREFLIGHT_PASSED",
        "REMOTE_PREFLIGHT_PASSED_WITH_WARNINGS",
        "REMOTE_PREFLIGHT_BLOCKED",
        "NEEDS_DEPLOY",
        "NEEDS_PROXY_SETUP",
        "ADOPT_EXISTING_VERIFYING",
        "ADOPTED_EXISTING",
        "STOPPED_BEFORE_APPROVAL",
        "SUBMITTED",
        "RUNNING",
        "AUDITING",
        "WAITING_APPROVAL",
        "BLOCKED",
        "FAILED",
        "COMPLETED"
      ]
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "spec_path": {"type": "string"},
    "local_commit": {"type": ["string", "null"]},
    "remote_commit": {"type": ["string", "null"]},
    "slurm_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["stage_id", "job_id", "slurm_state"],
        "properties": {
          "stage_id": {"type": "string"},
          "job_id": {"type": "string", "pattern": "^[0-9]+$"},
          "slurm_state": {"type": "string"},
          "exit_code": {"type": ["string", "null"]}
        }
      }
    },
    "adopted_stages": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "next_stage": {"type": ["string", "null"]},
    "remote_write_performed": {"type": "boolean"},
    "stages": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/stage_record"}
    },
    "approvals": {"type": "object"},
    "stop_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "stage_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "attempt"],
      "properties": {
        "stage_id": {"type": "string"},
        "attempt": {"type": "integer", "minimum": 1},
        "start_time": {"type": ["string", "null"]},
        "end_time": {"type": ["string", "null"]},
        "command_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "cwd": {"type": "string"},
        "return_code": {"type": ["integer", "null"]},
        "stdout_path": {"type": ["string", "null"]},
        "stderr_path": {"type": ["string", "null"]},
        "artifacts": {"type": "array"},
        "gate_result": {"type": ["string", "null"]},
        "job_id": {"type": ["string", "null"]},
        "git_commit": {"type": ["string", "null"]},
        "remote_git_commit": {"type": ["string", "null"]},
        "status": {"type": "string"}
      }
    }
  }
}
