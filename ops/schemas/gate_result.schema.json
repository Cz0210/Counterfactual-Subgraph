{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "stage_id",
    "audit_passed",
    "run_complete",
    "failed_hard_checks",
    "checks",
    "artifacts",
    "provenance",
    "next_stage",
    "message"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string"},
    "run_id": {"type": "string"},
    "stage_id": {"type": "string"},
    "audit_passed": {"type": "boolean"},
    "run_complete": {"type": "boolean"},
    "failed_hard_checks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "checks": {"type": "object"},
    "artifacts": {"type": "object"},
    "provenance": {"type": "object"},
    "next_stage": {"type": ["string", "null"]},
    "message": {"type": "string"}
  }
}
