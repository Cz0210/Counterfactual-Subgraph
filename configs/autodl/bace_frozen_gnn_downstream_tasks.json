{
  "schema_version": "bace_frozen_gnn_downstream_controller_contract_v1",
  "execution": {
    "foreground": true,
    "wrapper": "scripts/autodl/run_bace_frozen_gnn_downstream.sh",
    "controller_owns_gpu_lock": true,
    "controller_owns_retry": true,
    "pool_shard_resume_flag": "--resume",
    "dependency_output_mode": "controller_passing_attempt_output_token",
    "never_bind_attempt_zero_literal": true,
    "instance_output_token_format": "{dep_<task_id>_shard_000_output}",
    "instance_token_sanitization": "replace every non-alphanumeric character with underscore",
    "parent_manifest_expansion_requires_dependency_context": true,
    "num_fixed_shards": 4,
    "shard_rule": "sorted(parent_id)_position_mod_4",
    "required_env": [
      "AUTODL_DATA_ROOT",
      "AUTODL_CONTROL_ROOT",
      "AUTODL_PYTHON",
      "BACE_SPLIT_ROOT",
      "BACE_GNN_CHECKPOINT",
      "CHEMLLM_MODEL_PATH",
      "MOLCLR_ROOT",
      "MOLCLR_CHECKPOINT",
      "WNODE_CACHE_DB",
      "NODE_EMBEDDING_CACHE_DIR"
    ]
  },
  "controller_task_order": [
    "bace_b7_prep_gnn_before",
    "bace_b7_prep_molclr_parent",
    "bace_b7_prep_shard_manifests",
    "bace_b7_prep_output_preflight",
    "bace_b8_pool_base",
    "bace_b9_pool_hightemp",
    "bace_b10_pool_merged",
    "bace_b11_verification_shards",
    "bace_b11_cross_parent_verified",
    "bace_b12_selector",
    "bace_b13_test_parent_manifest",
    "bace_b13_verification_shards",
    "bace_b13_final_eval",
    "bace_b14_frozen"
  ],
  "controller_stage_roles": {
    "bace_b11_verification_shards": "non_publishing_shards",
    "bace_b11_cross_parent_verified": "official_B11_merge",
    "bace_b13_test_parent_manifest": "post_B12_test_access_non_publishing",
    "bace_b13_verification_shards": "non_publishing_test_shards",
    "bace_b13_final_eval": "official_B13_merge",
    "bace_b14_frozen": "manifest_only"
  },
  "b7_parallel_prep": {
    "dependency": "B6_PPO_SMOKE_V2",
    "actions": [
      "CALIBRATION_GNN_BEFORE_CACHE",
      "CALIBRATION_MOLCLR_PARENT_CACHE",
      "FIXED_SHARD_MANIFESTS",
      "OUTPUT_PREFLIGHT"
    ],
    "required_outputs": ["prep_manifest.json", "PASS"],
    "required_outputs_by_action": {
      "CALIBRATION_GNN_BEFORE_CACHE": [
        "calibration_parent_gnn_before.jsonl",
        "prep_manifest.json",
        "PASS"
      ],
      "CALIBRATION_MOLCLR_PARENT_CACHE": [
        "calibration_parent_molclr_cache.jsonl",
        "prep_manifest.json",
        "PASS"
      ],
      "FIXED_SHARD_MANIFESTS": [
        "train_parent_ids.frozen.json",
        "calibration_parent_ids.frozen.json",
        "train_parent_shards.jsonl",
        "calibration_parent_shards.jsonl",
        "prep_manifest.json",
        "PASS"
      ],
      "OUTPUT_PREFLIGHT": [
        "output_preflight.jsonl",
        "prep_manifest.json",
        "PASS"
      ]
    },
    "required_log_marker": "[BACE_B7_PARALLEL_PREP_PASS]",
    "forbidden": ["test", "policy checkpoint", "candidate generation"],
    "controller_tasks": [
      "bace_b7_prep_gnn_before",
      "bace_b7_prep_molclr_parent",
      "bace_b7_prep_shard_manifests",
      "bace_b7_prep_output_preflight"
    ],
    "commands": {
      "CALIBRATION_GNN_BEFORE_CACHE": [
        "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
        "prep",
        "--prep-action",
        "CALIBRATION_GNN_BEFORE_CACHE",
        "--b6-output",
        "{dep_bace_b6_ppo_smoke_output}",
        "--calibration-split",
        "{BACE_SPLIT_ROOT}/calibration.csv",
        "--gnn-checkpoint",
        "{BACE_GNN_CHECKPOINT}",
        "--output-dir",
        "{task_output}"
      ],
      "CALIBRATION_MOLCLR_PARENT_CACHE": [
        "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
        "prep",
        "--prep-action",
        "CALIBRATION_MOLCLR_PARENT_CACHE",
        "--b6-output",
        "{dep_bace_b6_ppo_smoke_output}",
        "--calibration-split",
        "{BACE_SPLIT_ROOT}/calibration.csv",
        "--molclr-root",
        "{MOLCLR_ROOT}",
        "--molclr-checkpoint",
        "{MOLCLR_CHECKPOINT}",
        "--node-embedding-cache-dir",
        "{NODE_EMBEDDING_CACHE_DIR}",
        "--output-dir",
        "{task_output}"
      ],
      "FIXED_SHARD_MANIFESTS": [
        "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
        "prep",
        "--prep-action",
        "FIXED_SHARD_MANIFESTS",
        "--b6-output",
        "{dep_bace_b6_ppo_smoke_output}",
        "--train-split",
        "{BACE_SPLIT_ROOT}/train.csv",
        "--calibration-split",
        "{BACE_SPLIT_ROOT}/calibration.csv",
        "--output-dir",
        "{task_output}"
      ],
      "OUTPUT_PREFLIGHT": [
        "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
        "prep",
        "--prep-action",
        "OUTPUT_PREFLIGHT",
        "--b6-output",
        "{dep_bace_b6_ppo_smoke_output}",
        "--planned-output-root",
        "{artifact_root}/bace/frozen_gnn_downstream/b8-base",
        "--planned-output-root",
        "{artifact_root}/bace/frozen_gnn_downstream/b9-hightemp",
        "--planned-output-root",
        "{artifact_root}/bace/frozen_gnn_downstream/b11",
        "--output-dir",
        "{task_output}"
      ]
    }
  },
  "B8_POOL_BASE": {
    "controller_task_id": "bace_b8_pool_base",
    "action": "pool-shard",
    "dependency": "B7_PPO_FULL",
    "shards": [0, 1, 2, 3],
    "controller_parent_manifest": "{dep_bace_b7_prep_shard_manifests_output}/train_parent_ids.frozen.json",
    "command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "pool-shard",
      "--stage",
      "B8_POOL_BASE",
      "--shard-index",
      "{shard_id}",
      "--parent-shard-manifest",
      "{shard_manifest}",
      "--train-split",
      "{BACE_SPLIT_ROOT}/train.csv",
      "--b7-output",
      "{dep_bace_b7_ppo_full_output}",
      "--policy-checkpoint",
      "{dep_bace_b7_ppo_full_output}",
      "--base-model-path",
      "{CHEMLLM_MODEL_PATH}",
      "--gnn-checkpoint",
      "{BACE_GNN_CHECKPOINT}",
      "--output-dir",
      "{task_output}",
      "--resume"
    ],
    "required_outputs": [
      "candidate_pool.jsonl",
      "pool_manifest.json",
      "oracle_provenance.json",
      "PASS"
    ],
    "required_log_marker": "[BACE_B8_POOL_BASE_SHARD_PASS]"
  },
  "B9_POOL_HIGHTEMP": {
    "controller_task_id": "bace_b9_pool_hightemp",
    "action": "pool-shard",
    "dependency": "B7_PPO_FULL",
    "shards": [0, 1, 2, 3],
    "controller_parent_manifest": "{dep_bace_b7_prep_shard_manifests_output}/train_parent_ids.frozen.json",
    "command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "pool-shard",
      "--stage",
      "B9_POOL_HIGHTEMP",
      "--shard-index",
      "{shard_id}",
      "--parent-shard-manifest",
      "{shard_manifest}",
      "--train-split",
      "{BACE_SPLIT_ROOT}/train.csv",
      "--b7-output",
      "{dep_bace_b7_ppo_full_output}",
      "--policy-checkpoint",
      "{dep_bace_b7_ppo_full_output}",
      "--base-model-path",
      "{CHEMLLM_MODEL_PATH}",
      "--gnn-checkpoint",
      "{BACE_GNN_CHECKPOINT}",
      "--output-dir",
      "{task_output}",
      "--resume"
    ],
    "required_outputs": [
      "candidate_pool.jsonl",
      "pool_manifest.json",
      "oracle_provenance.json",
      "PASS"
    ],
    "required_log_marker": "[BACE_B9_POOL_HIGHTEMP_SHARD_PASS]"
  },
  "B10_POOL_MERGED": {
    "controller_task_id": "bace_b10_pool_merged",
    "action": "merge-pools",
    "dependencies": [
      "B8_POOL_BASE_SHARD_0",
      "B8_POOL_BASE_SHARD_1",
      "B8_POOL_BASE_SHARD_2",
      "B8_POOL_BASE_SHARD_3",
      "B9_POOL_HIGHTEMP_SHARD_0",
      "B9_POOL_HIGHTEMP_SHARD_1",
      "B9_POOL_HIGHTEMP_SHARD_2",
      "B9_POOL_HIGHTEMP_SHARD_3"
    ],
    "command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "merge-pools",
      "--shard-dir",
      "{dep_bace_b8_pool_base_shard_000_output}",
      "--shard-dir",
      "{dep_bace_b8_pool_base_shard_001_output}",
      "--shard-dir",
      "{dep_bace_b8_pool_base_shard_002_output}",
      "--shard-dir",
      "{dep_bace_b8_pool_base_shard_003_output}",
      "--shard-dir",
      "{dep_bace_b9_pool_hightemp_shard_000_output}",
      "--shard-dir",
      "{dep_bace_b9_pool_hightemp_shard_001_output}",
      "--shard-dir",
      "{dep_bace_b9_pool_hightemp_shard_002_output}",
      "--shard-dir",
      "{dep_bace_b9_pool_hightemp_shard_003_output}",
      "--output-dir",
      "{task_output}"
    ],
    "required_outputs": [
      "candidate_pool.jsonl",
      "candidate_universe.jsonl",
      "merge_manifest.json",
      "pool_manifest.json",
      "oracle_provenance.json",
      "PASS"
    ],
    "required_log_marker": "[BACE_B10_PASS]"
  },
  "B11_CROSS_PARENT_VERIFIED": {
    "controller_shard_task_id": "bace_b11_verification_shards",
    "controller_merge_task_id": "bace_b11_cross_parent_verified",
    "shard_action": "verify-shard",
    "merge_action": "merge-verification",
    "dependencies": [
      "B10_POOL_MERGED",
      "CALIBRATION_GNN_BEFORE_CACHE",
      "FIXED_SHARD_MANIFESTS"
    ],
    "split": "calibration",
    "optional_read_only_input": "CALIBRATION_GNN_BEFORE_CACHE/calibration_parent_gnn_before.jsonl",
    "shards": [0, 1, 2, 3],
    "controller_parent_manifest": "{dep_bace_b7_prep_shard_manifests_output}/calibration_parent_ids.frozen.json",
    "shard_command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "verify-shard",
      "--stage",
      "B11_CROSS_PARENT_VERIFIED",
      "--shard-index",
      "{shard_id}",
      "--parent-shard-manifest",
      "{shard_manifest}",
      "--split-path",
      "{BACE_SPLIT_ROOT}/calibration.csv",
      "--predecessor-output",
      "{dep_bace_b10_output}",
      "--gnn-checkpoint",
      "{BACE_GNN_CHECKPOINT}",
      "--molclr-root",
      "{MOLCLR_ROOT}",
      "--molclr-checkpoint",
      "{MOLCLR_CHECKPOINT}",
      "--wnode-cache-db",
      "{WNODE_CACHE_DB}",
      "--node-embedding-cache-dir",
      "{NODE_EMBEDDING_CACHE_DIR}",
      "--parent-before-cache",
      "{dep_bace_calibration_gnn_before_prep_output}/calibration_parent_gnn_before.jsonl",
      "--output-dir",
      "{task_output}"
    ],
    "merge_command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "merge-verification",
      "--stage",
      "B11_CROSS_PARENT_VERIFIED",
      "--shard-dir",
      "{dep_bace_b11_verification_shards_shard_000_output}",
      "--shard-dir",
      "{dep_bace_b11_verification_shards_shard_001_output}",
      "--shard-dir",
      "{dep_bace_b11_verification_shards_shard_002_output}",
      "--shard-dir",
      "{dep_bace_b11_verification_shards_shard_003_output}",
      "--predecessor-output",
      "{dep_bace_b10_output}",
      "--output-dir",
      "{task_output}"
    ],
    "required_shard_outputs": [
      "pair_details.jsonl",
      "match_instances.jsonl",
      "verification_manifest.json",
      "oracle_provenance.json",
      "PASS"
    ],
    "required_merge_outputs": [
      "pair_matrix.jsonl",
      "match_instances.jsonl",
      "selected_candidate_universe.jsonl",
      "summary.json",
      "run_manifest.json",
      "matrix_manifest.json",
      "oracle_provenance.json",
      "PASS"
    ],
    "required_shard_log_marker": "[BACE_B11_CROSS_PARENT_VERIFIED_SHARD_PASS]",
    "required_merge_log_marker": "[BACE_B11_PASS]"
  },
  "B12_SELECTOR": {
    "controller_task_id": "bace_b12_selector",
    "action": "select",
    "dependency": "B11_CROSS_PARENT_VERIFIED_MERGE",
    "resource": "cpu",
    "command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "select",
      "--matrix-output",
      "{dep_bace_b11_merge_output}",
      "--output-dir",
      "{task_output}"
    ],
    "required_outputs": [
      "selected_top20.json",
      "frozen_selection_manifest.json",
      "thresholds.json",
      "oracle_provenance.json",
      "PASS"
    ],
    "required_log_marker": "[BACE_B12_SELECTOR_FROZEN]"
  },
  "B13_TEST_PARENT_MANIFEST": {
    "controller_task_id": "bace_b13_test_parent_manifest",
    "action": "prepare-test-shards",
    "dependency": "B12_SELECTOR",
    "resource": "cpu",
    "data_boundary": "first_test_access_after_frozen_B12",
    "command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "prepare-test-shards",
      "--b12-output",
      "{dep_bace_b12_selector_output}",
      "--test-split",
      "{BACE_SPLIT_ROOT}/test.csv",
      "--output-dir",
      "{task_output}"
    ],
    "required_outputs": [
      "test_parent_ids.frozen.json",
      "test_shard_manifest.json",
      "PASS"
    ],
    "required_log_marker": "[BACE_B13_TEST_PARENT_MANIFEST_PASS]"
  },
  "B13_FINAL_EVAL": {
    "controller_shard_task_id": "bace_b13_verification_shards",
    "controller_merge_task_id": "bace_b13_final_eval",
    "shard_action": "verify-shard",
    "merge_action": "merge-verification",
    "dependencies": ["B12_SELECTOR", "B13_TEST_PARENT_MANIFEST"],
    "split": "test_after_freeze_only",
    "shards": [0, 1, 2, 3],
