  "B14_FROZEN": {
    "controller_task_id": "bace_b14_frozen",
    "action": "freeze",
    "dependencies": ["B12_SELECTOR", "B13_FINAL_EVAL_MERGE"],
    "resource": "cpu",
    "manifest_only": true,
    "command": [
      "{execution_worktree}/scripts/autodl/run_bace_frozen_gnn_downstream.sh",
      "freeze",
      "--b12-output",
      "{dep_bace_b12_output}",
      "--b13-output",
