      "merge-verification",
      "--stage",
      "B13_FINAL_EVAL",
      "--shard-dir",
      "{dep_bace_b13_verification_shards_shard_000_output}",
      "--shard-dir",
      "{dep_bace_b13_verification_shards_shard_001_output}",
      "--shard-dir",
      "{dep_bace_b13_verification_shards_shard_002_output}",
      "--shard-dir",
      "{dep_bace_b13_verification_shards_shard_003_output}",
      "--predecessor-output",
      "{dep_bace_b12_output}",
      "--output-dir",
