      "{MOLCLR_ROOT}",
      "--molclr-checkpoint",
      "{MOLCLR_CHECKPOINT}",
      "--wnode-cache-db",
      "{WNODE_CACHE_DB}",
      "--node-embedding-cache-dir",
      "{NODE_EMBEDDING_CACHE_DIR}",
      "--output-dir",
      "{task_output}"
    ],
    "merge_command": [
